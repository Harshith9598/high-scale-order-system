# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/orderdb
DATABASE_USERNAME=orderuser
DATABASE_PASSWORD=orderpass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Configuration
# Generate a 256-bit+ secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Payment Simulation
PAYMENT_FAILURE_RATE=0.05
PAYMENT_PROCESSING_DELAY_MS=100

# Outbox
OUTBOX_POLLING_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
