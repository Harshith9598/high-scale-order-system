# Example configuration for load-test/order-load-test.js and run.sh.
# Copy to e.g. load-test/config.env and `set -a; . ./config.env; set +a`.
# Contains ONLY non-secret local defaults. Never put real credentials here.

# Target (local only by default)
BASE_URL=http://localhost:8080
PROFILE=smoke            # smoke | baseline | load | stress | soak

# Workload
ORDER_QUANTITY=1
POLL_COMPLETION=true     # poll each order to a terminal state
COMPLETION_TIMEOUT_S=60  # per-order deadline; pending orders reported separately
POLL_INTERVAL_S=1
THINK_TIME_S=0
HTTP_TIMEOUT=30s

# Synthetic data identity (seeded by scripts/seed-load-data.sql)
LOADTEST_PRODUCT_PREFIX=LOADTEST-
LOADTEST_USER_PREFIX=loadtest
LOADTEST_USER_PASSWORD=LoadTest!123   # synthetic local users only

# Safety caps (run aborts if the profile exceeds these)
MAX_VUS=60
MAX_DURATION_S=1800

# Thresholds
ERROR_RATE_MAX=0.01
P95_MS_MAX=5000
# COMPLETION_RATE_MIN=0.95   # optional; unset = report only, do not fail

# Load profile stage tuning
LOAD_RAMP_S=60
LOAD_HOLD_S=120
# Stress profile (opt-in; never in ordinary CI)
# CONFIRM_STRESS=true
STRESS_MAX_VUS=50
STRESS_STEP_S=120
# Soak profile (opt-in; never in ordinary CI)
# CONFIRM_SOAK=true
SOAK_VUS=10
SOAK_DURATION=15m

# Non-local targets are REFUSED unless BOTH are set and the host matches.
# Production-looking hosts are always refused.
# LOADTEST_ALLOW_NON_LOCAL=true
# LOADTEST_ALLOWED_HOSTS=staging.example.internal
